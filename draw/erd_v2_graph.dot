digraph ERD {
  graph [rankdir="LR", splines=true, overlap=false];
  node [shape=plaintext,fontname="Helvetica"];
  "activity_logs" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2"><B>activity_logs</B></TD></TR><TR><TD ALIGN="left">id</TD><TD ALIGN="left">int NOT NULL AUTO_INCREMENT</TD></TR><TR><TD ALIGN="left">user_id</TD><TD ALIGN="left">int</TD></TR><TR><TD ALIGN="left">action_type</TD><TD ALIGN="left">enum(&#x27;user_register&#x27;,&#x27;user_login&#x27;,&#x27;user_logout&#x27;,&#x27;user_update&#x27;,&#x27;user_delete&#x27;,&#x27;user_ban&#x27;,&#x27;user_unban&#x27;,&#x27;post_create&#x27;,&#x27;post_update&#x27;,&#x27;post_delete&#x27;,&#x27;post_publish&#x27;,&#x27;comment_create&#x27;,&#x27;comment_update&#x27;,&#x27;comment_delete&#x27;,&#x27;report_create&#x27;,&#x27;report_resolve&#x27;,&#x27;admin_action&#x27;,&#x27;system_event&#x27;,&#x27;other&#x27;) COLLATE utf8mb4_unicode_ci NOT NULL</TD></TR><TR><TD ALIGN="left">action_description</TD><TD ALIGN="left">varchar(255) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">target_type</TD><TD ALIGN="left">varchar(50) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">target_id</TD><TD ALIGN="left">int</TD></TR><TR><TD ALIGN="left">meta_data</TD><TD ALIGN="left">text COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">ip_address</TD><TD ALIGN="left">varchar(45) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">user_agent</TD><TD ALIGN="left">varchar(255) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">severity</TD><TD ALIGN="left">enum(&#x27;info&#x27;,&#x27;warning&#x27;,&#x27;error&#x27;,&#x27;critical&#x27;) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">created_at</TD><TD ALIGN="left">datetime</TD></TR></TABLE>>];
  "banned_keywords" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2"><B>banned_keywords</B></TD></TR><TR><TD ALIGN="left">id</TD><TD ALIGN="left">int NOT NULL AUTO_INCREMENT</TD></TR><TR><TD ALIGN="left">keyword</TD><TD ALIGN="left">varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL</TD></TR><TR><TD ALIGN="left">severity</TD><TD ALIGN="left">enum(&#x27;low&#x27;,&#x27;medium&#x27;,&#x27;high&#x27;,&#x27;critical&#x27;) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">description</TD><TD ALIGN="left">text COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">created_by</TD><TD ALIGN="left">int NOT NULL</TD></TR><TR><TD ALIGN="left">created_at</TD><TD ALIGN="left">datetime</TD></TR><TR><TD ALIGN="left">updated_at</TD><TD ALIGN="left">datetime</TD></TR><TR><TD ALIGN="left">is_active</TD><TD ALIGN="left">tinyint(1)</TD></TR></TABLE>>];
  "bookings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2"><B>bookings</B></TD></TR><TR><TD ALIGN="left">id</TD><TD ALIGN="left">int NOT NULL AUTO_INCREMENT</TD></TR><TR><TD ALIGN="left">tour_id</TD><TD ALIGN="left">int NOT NULL</TD></TR><TR><TD ALIGN="left">user_id</TD><TD ALIGN="left">int NOT NULL</TD></TR><TR><TD ALIGN="left">date</TD><TD ALIGN="left">varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL</TD></TR><TR><TD ALIGN="left">participants</TD><TD ALIGN="left">int NOT NULL</TD></TR><TR><TD ALIGN="left">adults</TD><TD ALIGN="left">int</TD></TR><TR><TD ALIGN="left">children</TD><TD ALIGN="left">int</TD></TR><TR><TD ALIGN="left">infants</TD><TD ALIGN="left">int</TD></TR><TR><TD ALIGN="left">full_name</TD><TD ALIGN="left">varchar(255) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">email</TD><TD ALIGN="left">varchar(255) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">phone</TD><TD ALIGN="left">varchar(50) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">address</TD><TD ALIGN="left">text COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">base_price</TD><TD ALIGN="left">float</TD></TR><TR><TD ALIGN="left">adult_price</TD><TD ALIGN="left">float</TD></TR><TR><TD ALIGN="left">child_price</TD><TD ALIGN="left">float</TD></TR><TR><TD ALIGN="left">infant_price</TD><TD ALIGN="left">float</TD></TR><TR><TD ALIGN="left">discount_code</TD><TD ALIGN="left">varchar(50) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">discount_amount</TD><TD ALIGN="left">float</TD></TR><TR><TD ALIGN="left">total_price</TD><TD ALIGN="left">float NOT NULL</TD></TR><TR><TD ALIGN="left">currency</TD><TD ALIGN="left">varchar(10) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">payment_method</TD><TD ALIGN="left">enum(&#x27;office&#x27;,&#x27;bank_transfer&#x27;,&#x27;online&#x27;) COLLATE utf8mb4_unicode_ci</TD></TR><TR><TD ALIGN="left">payment_status</TD><TD ALIGN="left">enum(&#x27;unpaid&#x27;,&#x27;partial&#x27;,&#x27;paid